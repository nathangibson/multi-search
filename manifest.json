{
  "manifest_version": 3,
  "name": "Multi-Search",
  "version": "1.0.0",
  "description": "Search multiple sites simultaneously from a single interface.",

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "sidebar_action": {
    "default_title": "Multi-Search",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },

  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },

  "background": {
    "scripts": ["background.js"]
  },

  "permissions": [
    "storage",
    "tabs",
    "tabGroups"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "multi-search-bibliography@extension",
      "strict_min_version": "139.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
