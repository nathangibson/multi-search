{
  "servers": {
    "local-coder": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/bin/python3.14",
      "args": ["${workspaceFolder}/server.py"],
      "env": {
        "LOCAL_MODEL_BASE_URL": "http://localhost:1234",
        "LOCAL_MODEL_API_KEY": "local",
        "SERVER_MODEL_BASE_URL": "${env:SERVER_MODEL_BASE_URL}",
        "SERVER_MODEL_API_KEY": "${env:SERVER_MODEL_API_KEY}",
        "SERVER_MODEL_NAME": "${env:SERVER_MODEL_NAME}"
      }
    },
    "local-anonymizer": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/bin/python3.10",
      "args": ["${workspaceFolder}/server.py"],
      "env": {
        "LM_STUDIO_BASE_URL": "http://127.0.0.1:1234",
        "ANONYMIZER_MODEL": "qwen/qwen3-4b-2507"
      }
    }
  }
}
